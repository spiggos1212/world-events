{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-events",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "discoverworldevents.com", "custom_domain": true },
    { "pattern": "www.discoverworldevents.com", "custom_domain": true }
  ]
}
